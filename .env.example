# ── Backend ──────────────────────────────────────────────────────────────────
# No API keys required for default data sources (OSM/Overpass/OSRM/Nominatim)
# The following are only needed if you switch to paid/keyed alternatives.

# Optional: openrouteservice API key (only if replacing OSRM public demo server)
# ORS_API_KEY=your_openrouteservice_api_key_here

# Backend server settings
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: custom Overpass API endpoint (defaults to https://overpass-api.de/api/interpreter)
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Optional: custom OSRM endpoint (defaults to http://router.project-osrm.org)
# OSRM_BASE_URL=http://router.project-osrm.org

# Optional: custom Nominatim endpoint (defaults to https://nominatim.openstreetmap.org)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Application ──────────────────────────────────────────────────────────────
# User-Agent string sent with API requests (change to your project/contact info)
APP_USER_AGENT=SafeRouteAI-ResearchTool/2.0 (research; contact: your@email.com)
